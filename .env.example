# Optional. With a Serper key (https://serper.dev, free tier available) the WORKER runs LIVE
# verification against real search results. WITHOUT it, the worker runs in DEMO mode against a
# built-in sample catalogue, so judges can run the full decoupled stack with zero setup.
SERPER_API_KEY=

# Redis connection for the BullMQ job queue shared by the web (producer) and worker (consumer).
# docker-compose sets this to the internal `redis` service automatically.
REDIS_URL=redis://localhost:6379

# How many verification jobs one worker replica processes at once.
WORKER_CONCURRENCY=4
